---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  currentPage?: string;
}
const { title, description, currentPage = '' } = Astro.props;
---
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

  <!-- HIDDEN FOR MVP (RSS autodiscovery). The feed itself still exists at
       /feed.xml — remove this comment wrapper to advertise it again.
  <link rel="alternate" type="application/rss+xml" title="Leticia S. Emidio — Resources feed" href="/feed.xml" />
  -->

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Lora:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <a class="skip-link" href="#main">Skip to main content</a>
  <Header currentPage={currentPage} />
  <main id="main">
    <slot />
  </main>
  <Footer />
</body>
</html>
